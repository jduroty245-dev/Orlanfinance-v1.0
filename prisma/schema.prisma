// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AccountType {
  BANK
  CASH
  WALLET
  SAVINGS
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  ADJUSTMENT
}

enum DebtDirection {
  OWED_BY_ME   // I owe someone
  OWED_TO_ME   // Someone owes me
}

enum InsightCategory {
  SPENDING
  BUDGET
  CASH_FLOW
  DEBT
  SAVINGS
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ─── Core entities ────────────────────────────────────────────────────────────

/// One row per Supabase Auth user. userId mirrors auth.users.id.
model User {
  id                   String                @id @default(cuid())
  supabaseId           String                @unique // mirrors auth.users.id
  email                String                @unique
  name                 String?
  currency             String                @default("NGN") // ISO 4217
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  debts                Debt[]
  recurringTransactions RecurringTransaction[]
  insights             Insight[]
}

/// Bank account, cash wallet, etc. Balance is DERIVED from transactions — never
/// stored as an independently-editable number.
model Account {
  id           String      @id @default(cuid())
  userId       String
  name         String
  type         AccountType
  currency     String      @default("NGN")
  description  String?
  isArchived   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transactions where this account is the primary account
  transactions          Transaction[]          @relation("AccountTransactions")
  // Transactions where this account is the destination (transfers)
  incomingTransfers     Transaction[]          @relation("TransferToAccount")

  @@index([userId])
}

/// User-defined spending/income categories. Not hardcoded.
model Category {
  id           String    @id @default(cuid())
  userId       String
  name         String
  icon         String?   // emoji or icon key
  color        String?   // hex color
  isDefault    Boolean   @default(false) // seeded defaults can be flagged
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

/// Every money movement. Transfers link two accounts. Debt repayments link to a Debt.
model Transaction {
  id                String          @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String?
  type              TransactionType
  amount            Decimal         @db.Decimal(18, 2)
  currency          String          @default("NGN")
  note              String?
  date              DateTime
  // Transfer fields — both set when type = TRANSFER
  transferToAccountId String?
  // Debt repayment link — set when this transaction records a repayment
  debtRepayment     DebtRepayment?
  // Recurring source — set if generated from a RecurringTransaction
  recurringTransactionId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation("AccountTransactions", fields: [accountId], references: [id])
  transferToAccount Account?        @relation("TransferToAccount", fields: [transferToAccountId], references: [id])
  category          Category?       @relation(fields: [categoryId], references: [id])
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([date])
}

/// Monthly spending limit per category.
model Budget {
  id           String    @id @default(cuid())
  userId       String
  categoryId   String
  name         String
  limitAmount  Decimal   @db.Decimal(18, 2)
  currency     String    @default("NGN")
  month        Int       // 1–12
  year         Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId])
}

/// A savings target with a deadline and optional monthly contribution.
model SavingsGoal {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  targetAmount        Decimal   @db.Decimal(18, 2)
  currentAmount       Decimal   @default(0) @db.Decimal(18, 2)
  currency            String    @default("NGN")
  targetDate          DateTime?
  monthlyContribution Decimal?  @db.Decimal(18, 2)
  isCompleted         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A debt I owe or am owed. Repayments are tracked via DebtRepayment.
model Debt {
  id              String        @id @default(cuid())
  userId          String
  name            String        // lender / borrower name
  direction       DebtDirection
  principalAmount Decimal       @db.Decimal(18, 2)
  currentBalance  Decimal       @db.Decimal(18, 2) // decreases with repayments
  currency        String        @default("NGN")
  interestRate    Decimal?      @db.Decimal(5, 4)  // e.g. 0.1500 = 15%
  minimumPayment  Decimal?      @db.Decimal(18, 2)
  dueDate         DateTime?
  note            String?
  isSettled       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments      DebtRepayment[]

  @@index([userId])
}

/// One repayment event. Links a Debt to the Transaction that paid it.
/// Recording a repayment must atomically: debit the account, reduce debt balance,
/// and create this row — enforced at the service layer.
model DebtRepayment {
  id            String      @id @default(cuid())
  debtId        String
  transactionId String      @unique // one repayment per transaction
  amount        Decimal     @db.Decimal(18, 2)
  note          String?
  createdAt     DateTime    @default(now())

  debt          Debt        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

/// A template for transactions that repeat on a schedule.
model RecurringTransaction {
  id           String             @id @default(cuid())
  userId       String
  categoryId   String?
  type         TransactionType
  amount       Decimal            @db.Decimal(18, 2)
  currency     String             @default("NGN")
  description  String
  frequency    RecurringFrequency
  startDate    DateTime
  endDate      DateTime?
  nextDueDate  DateTime
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?          @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([nextDueDate])
}

/// A generated, stored insight. Not computed fresh on every page load.
model Insight {
  id             String          @id @default(cuid())
  userId         String
  category       InsightCategory
  observation    String          // what happened
  interpretation String          // why it matters
  recommendation String          // what to do
  isRead         Boolean         @default(false)
  generatedAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([generatedAt])
}
